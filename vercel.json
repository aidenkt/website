{
  "version": 2,
  "builds": [
    {
      "src": "resources/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/privacy/?",
      "dest": "/resources/static/privacy/index.html"
    },
    {
      "src": "/resume/?",
      "dest": "/resources/static/resume.pdf"
    },
    {
      "src": "/(.*)",
      "dest": "/resources/static/$1"
    }
  ]
}
