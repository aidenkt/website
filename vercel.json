{
  "version": 2,
  "builds": [
    {
      "src": "resources/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(|privacy/?|wood/?|brand/?|.*\\.(html|css|js))",
      "headers": {
        "cache-control": "no-store"
      },
      "continue": true
    },
    {
      "src": "/privacy/?",
      "dest": "/resources/static/privacy/index.html"
    },
    {
      "src": "/wood/?",
      "dest": "/resources/static/wood/index.html"
    },
    {
      "src": "/brand/?",
      "dest": "/resources/static/brand/index.html"
    },
    {
      "src": "/resume/?",
      "dest": "/resources/static/resume.pdf"
    },
    {
      "src": "/(.*)",
      "dest": "/resources/static/$1"
    }
  ]
}
